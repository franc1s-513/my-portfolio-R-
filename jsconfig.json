{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@designcodeio/threeui": ["./src/shaders/threeui.tsx"],
      "@designcodeio/threeui/style.css": ["./src/shaders/threeui.css"]
    }
  },
  "include": ["src/**/*"]
}
